{
  "name": "trans-dev",
  "version": "0.1.0",
  "private": true,
  "description": "Wi-Fi file transfer between a phone and a desktop browser, no cable, no cloud.",
  "type": "module",
  "workspaces": [
    "apps/host",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n host,web -c magenta,cyan \"npm:dev:host\" \"npm:dev:web\"",
    "dev:host": "npm --workspace @trans/host run dev",
    "dev:web": "npm --workspace @trans/web run dev",
    "seed": "npm --workspace @trans/host run seed",
    "build": "npm --workspace @trans/web run build",
    "start": "npm --workspace @trans/host run start",
    "test": "npm --workspace @trans/host run test",
    "typecheck": "npm --workspace @trans/web run typecheck",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.19"
  }
}
